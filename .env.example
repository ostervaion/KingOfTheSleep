# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# ─── Application ──────────────────────────────────────────────
APP_ENV=development
# ─── Backend ─────────────────────────────────────────────────
SECRET_KEY="super-secret-key"
# ─── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=/api
# Build target: "development" (hot-reload) or "production"
FRONTEND_BUILD_TARGET=development

# ─── Caddy / Ports ────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443